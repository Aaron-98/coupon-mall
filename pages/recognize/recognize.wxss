
.upload-box { background:#f2edfe; color:#5833ba; border:2rpx dashed #9f83e9; border-radius:20rpx; margin:4rpx 0; padding:22rpx; width:100%; font-size:27rpx; }
.plus { display:block; line-height:1.2; font-size:56rpx; }
.preview { width:100%; height:280rpx; background:#f5f0ff; border-radius:15rpx; }
.evidence { position:relative; width:100%; }
.original { display:block; width:100%; }
.highlight { position:absolute; border:4rpx solid #6b46d8; background:rgba(112,77,230,.2); pointer-events:none; }
.raw { margin:8rpx 0; font-size:23rpx; color:#675088; overflow-wrap:anywhere; }
.mode-row { margin-top:0; }
