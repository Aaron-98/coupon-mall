
<view class="screen">
  <view class="page-title">运营管理</view>
  <view wx:if="{{error}}" class="notice error">{{error}}</view>
  <view wx:if="{{!dashboard}}" class="card stack">
    <input class="field" password placeholder="输入后台访问凭据" data-key="key" bindinput="field"/>
    <button class="primary" bindtap="load" loading="{{busy}}" disabled="{{busy}}">进入后台</button>
  </view>
  <block wx:else>
    <view class="card stack">
      <view class="section-title">访问角色：{{dashboard.role}}</view>
      <view class="muted">报价曝光会话 {{dashboard.metrics.viewSessions}} · 外跳发起会话 {{dashboard.metrics.outboundSessions}}（不代表成交）</view>
      <view class="muted">已保存可回放方案 {{dashboard.planCount}}</view>
    </view>
    <view class="card stack">
      <view class="row between"><text class="section-title">渠道状态</text><button class="plain" bindtap="load">刷新</button></view>
      <view>{{dashboard.source.label}} · {{dashboard.source.enabled ? '已开启' : '已关闭'}}</view>
      <view class="muted">授权有效期 {{dashboard.source.authorizationExpiresAt || '未配置'}}</view>
      <input class="field" placeholder="填写本次操作理由" data-key="reason" value="{{reason}}" bindinput="field" maxlength="220"/>
      <button class="secondary" disabled="{{busy}}" data-kind="sources" data-id="{{dashboard.source.id}}" data-version="{{dashboard.source.version}}" data-enabled="{{dashboard.source.enabled}}" bindtap="mutate">{{dashboard.source.enabled ? '关闭渠道' : '开启渠道'}}</button>
    </view>
    <view class="card stack">
      <view class="section-title">计价规则</view>
      <view class="muted">当前版本 {{dashboard.rule.version}} · {{dashboard.rule.couponsEnabled ? '启用券抵扣' : '暂停券抵扣'}}</view>
      <button class="secondary" disabled="{{busy}}" data-kind="rules" data-id="publish" data-version="{{dashboard.rule.version}}" data-enabled="{{dashboard.rule.couponsEnabled}}" bindtap="mutate">{{dashboard.rule.couponsEnabled ? '发布暂停抵扣版本' : '发布启用抵扣版本'}}</button>
      <view class="row"><input class="field grow" type="number" placeholder="历史版本号" data-key="rollback" value="{{rollback}}" bindinput="field"/><button class="secondary" disabled="{{busy}}" data-kind="rules" data-id="rollback" data-version="{{dashboard.rule.version}}" bindtap="mutate">回滚</button></view>
      <view wx:for="{{dashboard.rules}}" wx:key="version" class="muted">版本 {{item.version}} · {{item.couponsEnabled ? '启用券抵扣' : '暂停券抵扣'}}</view>
    </view>
    <view class="card stack">
      <view class="section-title">报价审核</view>
      <view wx:if="{{!dashboard.offers.length}}" class="muted">暂无报价</view>
      <view wx:for="{{dashboard.offers}}" wx:key="id" class="row between">
        <view class="grow"><view class="strong">{{item.name}}</view><view class="muted">{{item.shop}} · {{item.skuLabel}}</view></view>
        <button class="plain" disabled="{{busy}}" data-kind="offers" data-id="{{item.id}}" data-version="{{item.version}}" data-enabled="{{item.enabled}}" bindtap="mutate">{{item.enabled ? '下架' : '恢复'}}</button>
      </view>
    </view>
    <view class="card stack">
      <view class="section-title">反馈处置</view>
      <view wx:if="{{!dashboard.feedback.length}}" class="muted">暂无反馈</view>
      <view wx:for="{{dashboard.feedback}}" wx:key="id" class="row between">
        <view class="grow"><view class="strong">{{item.reason}}</view><view class="muted">{{item.description}}</view></view>
        <button wx:if="{{item.status === 'OPEN'}}" class="plain" disabled="{{busy}}" data-kind="feedback" data-id="{{item.id}}" data-version="{{item.version}}" bindtap="mutate">标记已处理</button>
        <text wx:else class="badge">已处理</text>
      </view>
    </view>
    <view class="card stack">
      <view class="section-title">审计记录</view>
      <view wx:if="{{!dashboard.audit.length}}" class="muted">暂无操作</view>
      <view wx:for="{{dashboard.audit}}" wx:key="id" class="muted">{{item.date}} · {{item.label}}{{item.reason ? ' · ' + item.reason : ''}}</view>
    </view>
  </block>
</view>
