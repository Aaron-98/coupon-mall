
<view class="screen">
  <view class="page-title">我的</view>
  <view class="card row between">
    <view><view class="section-title">{{loggedIn ? (demo ? '联调账号' : '已登录') : '游客会话'}}</view><view class="muted">{{loggedIn ? '查看个人识别记录与收藏' : '登录后同步收藏与识别记录'}}</view></view>
    <button wx:if="{{!loggedIn}}" class="secondary" loading="{{signingIn}}" disabled="{{signingIn}}" bindtap="login">{{demo ? '联调登录' : '微信登录'}}</button>
    <button wx:else class="plain" bindtap="logout">退出</button>
  </view>
  <view class="row between spaced"><text class="section-title">识别历史</text><button class="plain" bindtap="newTask">新建识别</button></view>
  <view wx:if="{{loading}}" class="card muted">正在加载记录…</view>
  <view wx:elif="{{error}}" class="notice error">{{error}}<button class="plain" bindtap="load">重试</button></view>
  <view wx:elif="{{!history.length}}" class="card muted">还没有识别记录。</view>
  <view wx:for="{{history}}" wx:key="id" class="card row between">
    <view class="grow" data-id="{{item.id}}" bindtap="open" role="button">
      <view class="strong">{{item.confirmedFields.product || (item.inputType === 'image' ? '截图识别' : '文字识别')}}</view>
      <view class="muted">{{item.date}} · {{item.statusLabel}}</view>
    </view>
    <button class="plain" data-id="{{item.id}}" bindtap="remove">删除</button>
  </view>
  <view class="card stack">
    <view class="section-title">隐私与反馈</view>
    <view class="actions"><button class="secondary" bindtap="privacy">隐私说明</button><button class="secondary" bindtap="deleteData">删除我的数据</button></view>
    <textarea class="area" placeholder="填写使用反馈" maxlength="500" value="{{feedback}}" bindinput="feedback"/>
    <button class="primary" bindtap="send">提交反馈</button>
  </view>
  <view wx:if="{{loggedIn}}" class="card stack">
    <view class="section-title">站内价格提醒</view>
    <view class="muted">只在打开本页时检查，不发送微信消息。记录价格请进入商品页再次核对。</view>
    <view wx:if="{{!notifications.length}}" class="muted">暂无到价记录</view>
    <view wx:for="{{notifications}}" wx:key="id" data-id="{{item.offerId}}" bindtap="offer">
      <view>{{item.demo ? '合成样例 · ' : ''}}{{item.name}} · {{item.amount}}</view>
      <view class="muted">{{item.date}} 采集 · {{item.context}}</view>
    </view>
    <view class="section-title">我的关注</view>
    <view wx:if="{{!subscriptions.length}}" class="muted">可在商品详情主动设置目标价格</view>
    <view wx:for="{{subscriptions}}" wx:key="offerId" class="row between">
      <view class="grow" data-id="{{item.offerId}}" bindtap="offer">目标 {{item.amount}} · 查看商品</view>
      <button class="plain" data-id="{{item.offerId}}" bindtap="unwatch">退订</button>
    </view>
  </view>
  <button wx:if="{{demo}}" class="plain" bindtap="admin">联调运营后台 ›</button>
</view>
